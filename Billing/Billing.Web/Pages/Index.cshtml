@page
@model Billing.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Загрузка файлов для тарификации";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Загрузка файлов для тарификации</h4>
            </div>

            <div class="card-body">
                <form method="post" enctype="multipart/form-data" id="uploadForm">

                    <!-- CDR файл -->
                    <div class="mb-3">
                        <label asp-for="CdrFile" class="form-label fw-bold">
                            CDR файл <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CdrFile"
                               type="file"
                               class="form-control"
                               required/>
                        <div class="form-text">
                            Файл с данными о звонках (разделитель "|")
                        </div>
                        <span asp-validation-for="CdrFile" class="text-danger"></span>
                    </div>

                    <!-- Файл тарифов -->
                    <div class="mb-3">
                        <label asp-for="TariffFile" class="form-label fw-bold">
                            Файл тарифов <span class="text-danger">*</span>
                        </label>
                        <input asp-for="TariffFile"
                               type="file"
                               class="form-control"
                               required/>
                        <div class="form-text">
                            CSV файл с тарифами (разделитель ";")
                        </div>
                        <span asp-validation-for="TariffFile" class="text-danger"></span>
                    </div>

                    <!-- Абонентская база -->
                    <div class="mb-3">
                        <label asp-for="SubscriberFile" class="form-label fw-bold">
                            Абонентская база <span class="text-danger">*</span>
                        </label>
                        <input asp-for="SubscriberFile"
                               type="file"
                               class="form-control"
                               required/>
                        <div class="form-text">
                            CSV файл с абонентами (разделитель ";")
                        </div>
                        <span asp-validation-for="SubscriberFile" class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-success w-100 btn-lg mt-3"
                            id="submitBtn">
                        Запустить тарификацию
                    </button>
                </form>

                @if (Model.Progress > 0)
                {
                    <div class="mt-4">
                        <h6>Прогресс обработки:</h6>
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                 role="progressbar"
                                 style="width: @Model.Progress%">
                                @Model.Progress%
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


<script>
    const form = document.getElementById("uploadForm");
    const button = document.getElementById("submitBtn");

    form.addEventListener("submit", function () {
        button.disabled = true;
        button.innerText = "Обработка...";
    });
</script>
