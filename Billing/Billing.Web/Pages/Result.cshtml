@page
@model ResultModel
@{
    ViewData["Title"] = "Результаты тарификации";
}

<div class="row">
    <div class="col-12">
        <!-- Итоги по абонентам -->
        <div class="card shadow mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Общая начисленная сумма по абонентам</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Абонент</th>
                            <th class="text-right">Сумма, ₽</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Totals.Any())
                        {
                            @foreach (var item in Model.Totals)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td class="text-right font-weight-bold text-success">
                                        @item.Total.ToString("F2")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted py-3">
                                    Нет данных для отображения
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Детализация звонков -->
        <div class="card shadow">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Детализация звонков</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Дата</th>
                                <th>Внутренний</th>
                                <th>Набранный</th>
                                <th>Направление</th>
                                <th>Минут</th>
                                <th>Тариф</th>
                                <th class="text-right">Стоимость</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Calls.Any())
                            {
                                @foreach (var call in Model.Calls)
                                {
                                    <tr>
                                        <td>@call.Call.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@call.Call.CallingParty</td>
                                        <td>@call.Call.CalledParty</td>
                                        <td>@call.AppliedTariff.Destination</td>
                                        <td>@Math.Ceiling(call.Call.BillableSeconds / 60m)</td>
                                        <td>@call.AppliedTariff.RatePerMinute.ToString("F2") ₽/мин</td>
                                        <td class="text-right font-weight-bold text-success">
                                            @call.CalculatedCost.ToString("F2")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3">
                                        Нет данных о звонках
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>